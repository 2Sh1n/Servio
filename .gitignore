
---

# `.gitignore`

Put this in the root folder:

```gitignore
# ============================================================
# OS / Editor
# ============================================================

.DS_Store
Thumbs.db
Desktop.ini

.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Keep useful VS Code project recommendations if needed
!.vscode/extensions.json
!.vscode/settings.json

# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.jks
*.keystore

# Firebase / Google credentials
firebase-service-account.json
google-services-private.json
service-account.json
firebase-service-account.json
google-services-private.json
service-account.json
firebase_config.json
apps/serviopanel/public/firebase_config.json

# ============================================================
# Logs
# ============================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
composer-debug.log*

# ============================================================
# PHP / Composer / CodeIgniter
# ============================================================

vendor/

# For deployable apps, composer.lock SHOULD usually be committed.
# Do not ignore composer.lock unless you deliberately want floating dependencies.
# composer.lock

apps/serviopanel/writable/cache/*
apps/serviopanel/writable/debugbar/*
apps/serviopanel/writable/logs/*
apps/serviopanel/writable/session/*
apps/serviopanel/writable/uploads/*

!apps/serviopanel/writable/cache/.gitkeep
!apps/serviopanel/writable/debugbar/.gitkeep
!apps/serviopanel/writable/logs/.gitkeep
!apps/serviopanel/writable/session/.gitkeep
!apps/serviopanel/writable/uploads/.gitkeep

# Uploaded files - do not version user/provider uploads
apps/serviopanel/public/uploads/*
apps/serviopanel/public/uploads/partner/*
apps/serviopanel/public/backend/assets/profile/*
apps/serviopanel/public/backend/assets/profiles/*
apps/serviopanel/public/backend/assets/banner/*
apps/serviopanel/public/backend/assets/national_id/*
apps/serviopanel/public/backend/assets/passport/*
apps/serviopanel/public/backend/assets/address_id/*

!apps/serviopanel/public/uploads/.gitkeep
!apps/serviopanel/public/uploads/partner/.gitkeep
!apps/serviopanel/public/backend/assets/profile/.gitkeep
!apps/serviopanel/public/backend/assets/profiles/.gitkeep
!apps/serviopanel/public/backend/assets/banner/.gitkeep

# ============================================================
# Node / Next.js
# ============================================================

node_modules/
.next/
out/
dist/
build/
coverage/
.vercel/
.netlify/

# Lock files should usually be committed for apps.
# Do not ignore package-lock.json, yarn.lock, or pnpm-lock.yaml.

# ============================================================
# Flutter / Dart
# ============================================================

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Flutter app build outputs
build/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
android/.gradle/
android/app/build/

# Mobile release artifacts
*.apk
*.aab
*.ipa

# IDE/project generated
*.iml

# ============================================================
# Android
# ============================================================

.gradle/
local.properties
captures/
GeneratedPluginRegistrant.java

# Android signing files
key.properties
upload-keystore.jks
release.keystore

# ============================================================
# iOS / macOS
# ============================================================

ios/Pods/
ios/Runner.xcworkspace/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
*.xcuserstate
xcuserdata/

# ============================================================
# Database dumps / backups
# ============================================================

*.sql
*.sql.gz
*.dump
*.backup
*.bak

# Allow sanitized sample database files
!database/sample_schema.sql
!database/sample_seed.sql

# ============================================================
# Archives
# ============================================================

*.zip
*.rar
*.7z
*.tar
*.tar.gz

# ============================================================
# Temporary files
# ============================================================

tmp/
temp/
.cache/